{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api/conteudo",
      "regex": "^/api/conteudo(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/conteudo(?:/)?$"
    },
    {
      "page": "/api/conteudos-cobrados",
      "regex": "^/api/conteudos\\-cobrados(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/conteudos\\-cobrados(?:/)?$"
    },
    {
      "page": "/api/geral",
      "regex": "^/api/geral(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/geral(?:/)?$"
    },
    {
      "page": "/api/ies",
      "regex": "^/api/ies(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/ies(?:/)?$"
    },
    {
      "page": "/api/ies/estatisticas",
      "regex": "^/api/ies/estatisticas(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/ies/estatisticas(?:/)?$"
    },
    {
      "page": "/api/ies/registro",
      "regex": "^/api/ies/registro(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/ies/registro(?:/)?$"
    },
    {
      "page": "/api/simulado/estatisticas",
      "regex": "^/api/simulado/estatisticas(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/simulado/estatisticas(?:/)?$"
    },
    {
      "page": "/api/simulado/registro",
      "regex": "^/api/simulado/registro(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/simulado/registro(?:/)?$"
    },
    {
      "page": "/conteudos",
      "regex": "^/conteudos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/conteudos(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/ies",
      "regex": "^/ies(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ies(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/simulado",
      "regex": "^/simulado(?:/)?$",
